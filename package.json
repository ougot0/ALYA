{
  "name": "alya-boutique",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "assets:placeholders": "node scripts/generate-placeholders.mjs",
    "assets:depth": "node scripts/prepare-product.mjs",
    "build:preview": "tsc -b && VITE_DEMO=1 vite build --base ./ --outDir dist-preview"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "stripe": "^23.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
