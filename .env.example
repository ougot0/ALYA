# Clé secrète Stripe (Dashboard > Développeurs > Clés API). Ne jamais committer la vraie valeur.
STRIPE_SECRET_KEY=sk_test_xxx
# Secret de signature du webhook Stripe (Dashboard > Webhooks > endpoint /api/stripe-webhook)
STRIPE_WEBHOOK_SECRET=whsec_xxx
# URL publique du site (utilisée pour les redirections Stripe)
SITE_URL=https://votre-site.netlify.app
# Pays de livraison autorisés au checkout (codes ISO séparés par des virgules)
SHIPPING_COUNTRIES=FR,BE,CH,LU
